 "notes": [
  {
   "title": "University College",
   "text": "A Collegiate Gothic building by John M. Moore, with Frederick H. Spier on the tower and auditorium. Its tower, the Middlesex Memorial Tower, honours the men of Middlesex County who fought in the First World War.",
   "links": [
    {
     "label": "Wikipedia",
     "url": "https://en.wikipedia.org/wiki/University_College_(University_of_Western_Ontario)"
    }
   ]
  },
  {
   "title": "Middlesex College",
   "text": "Collegiate Gothic, with its ground broken in 1959 and opened in fall 1960; known for its spire and clock tower, whose clock faces and Gillett & Johnston bells were installed in 1960.",
   "links": [
    {
     "label": "Wikipedia",
     "url": "https://en.wikipedia.org/wiki/Middlesex_College_(University_of_Western_Ontario)"
    }
   ]
  },
  {
   "title": "What is illustrative",
   "text": "Measured from OpenStreetMap: footprints, roads and paths. Drawn by eye: building heights, both towers' proportions, the Middlesex clock tower's place on the building and its spire (no source gives them), each lawn tree, people, traffic and the Homecoming crowd's purple.",
